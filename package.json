{
  "name": "extracker",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @extracker/api dev",
    "dev:web": "pnpm --filter @extracker/web dev",
    "db:generate": "pnpm --filter @extracker/api db:generate",
    "db:migrate": "pnpm --filter @extracker/api db:migrate"
  }
}
