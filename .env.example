# Copy to .env and fill in. .env is git-ignored: never commit it.
# docker compose reads .env from the repository root. So do `pnpm dev:api` and `pnpm dev:web`.

# --- Database (db, migrate and api services) ---
POSTGRES_USER=extracker
# Required. It also goes into a connection URL, so use letters and digits only,
# for example the output of: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=extracker

# --- API ---
# Port the API listens on inside its container. Not published on the host.
API_PORT=3000
# One of fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info
# Defaults for new users: ISO 4217 currency and BCP 47 locale.
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=en-IE

# --- Sign-in (api service) ---
# Required. Signs session cookies. At least 32 characters, for example the output of:
# openssl rand -base64 32
AUTH_SECRET=
# Public address of the web app, exactly as people type it in the browser. Scheme, host and port
# must all match, or every sign-in is refused: http://localhost:8080 and http://127.0.0.1:8080 are
# different addresses. docker compose uses http://localhost:${WEB_PORT} when this is not set.
# APP_URL=https://money.example.com
# true lets anyone who can open the app create an account. Open it to create yours, then close it.
AUTH_SIGNUP_ENABLED=false

# --- Web ---
# Host port for the web app (nginx). Open http://localhost:8080
WEB_PORT=8080

# --- Local development without Docker (pnpm dev:api, pnpm dev:web) ---
# docker compose builds DATABASE_URL from the POSTGRES_* values above, and sets
# API_UPSTREAM=http://api:${API_PORT} for nginx. The settings below are only for running outside Docker.
# DATABASE_URL=postgres://extracker:<password>@localhost:5432/extracker
# APP_URL=http://localhost:5173
# API_HOST=127.0.0.1
# API_PROXY_TARGET=http://localhost:3000
